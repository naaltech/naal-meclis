---
import ArrowLeftIcon from "heroicons/24/outline/arrow-left.svg"
import ExclamationTriangleIcon from "heroicons/24/outline/exclamation-triangle.svg"
import UsersIcon from "heroicons/24/outline/users.svg"
import Footer from "@/components/Footer.astro"
import Alert from "@/components/ui/Alert.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import CardContent from "@/components/ui/CardContent.astro"
import Layout from "@/layouts/Layout.astro"
import { committeesList } from "@/lib/committees"

export function getStaticPaths() {
  return committeesList.map((committee) => ({
    params: { id: committee.id },
    props: { committee },
  }))
}

const { committee } = Astro.props
const alert = "alert" in committee ? committee.alert : undefined
---

<Layout
  title={`${committee.name} | Nevzat Ayaz Anadolu LisesiMeclis Simülasyonu`}
  description={committee.about}
  ogTitle={`${committee.name} | Nevzat Ayaz Anadolu Lisesi Meclis Simülasyonu`}
  ogUrl={`https://meclis.naal.org.tr/komisyon/${committee.id}`}
  twitterTitle={`${committee.name} | Meclis Simülasyonu`}
  twitterDescription={committee.about}
>
  <div class="min-h-screen bg-white">
    {/* Header with green accent */}
    <div class="bg-primary h-2"></div>

    <div class="container mx-auto px-4 py-12">
      <Button variant="ghost" href="/" class="mb-8 -ml-4">
        <ArrowLeftIcon class="h-4 w-4 mr-2" />
        Ana Sayfaya Dön
      </Button>

      <div class="max-w-4xl mx-auto">
        {/* Committee Header */}
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 text-balance">{committee.name}</h1>
          <div class="flex items-center justify-center gap-2 text-muted-foreground">
            <UsersIcon class="h-5 w-5 text-primary" />
            <span class="text-lg">
              Delege Sayısı: <strong class="text-gray-900">{committee.delegates}</strong>
            </span>
          </div>
        </div>

        {/* About Section */}
        <Card class="border-2 border-primary/30 mb-8">
          <CardContent class="pt-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Komisyon Hakkında</h2>
            <p class="text-gray-700 leading-relaxed">{committee.about}</p>
          </CardContent>
        </Card>

        {/* Warning alert if committee has one */}
        {alert && (
          <Alert class="mb-8 border-amber-500 bg-amber-50">
            <ExclamationTriangleIcon class="h-5 w-5 text-amber-600" />
            <div class="col-start-2 grid justify-items-start gap-1 text-sm text-amber-900 font-medium ml-2">
              {alert}
            </div>
          </Alert>
        )}

        {/* Topics Section */}
        <Card class="border-2 border-primary/30">
          <CardContent class="pt-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Komisyon Konuları</h2>
            <ul class="space-y-4">
              {committee.topics.map((topic, index) => (
                <li class="flex gap-4 items-start">
                  <div class="h-6 w-6 rounded-full bg-primary flex items-center justify-center text-white text-sm font-bold flex-shrink-0 mt-0.5">
                    {index + 1}
                  </div>
                  <p class="text-gray-700 leading-relaxed pt-0.5">{topic}</p>
                </li>
              ))}
            </ul>
          </CardContent>
        </Card>

        {/* CTA */}
        <div class="mt-12 text-center">
          <Card class="border-2 border-primary/30 bg-green-50">
            <CardContent class="pt-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Bu Komisyona Katılmak İster Misiniz?</h3>
              <p class="text-gray-700 mb-6">
                Meclis simülasyonuna katılmak ve {committee.name} delegesi olmak için başvurunuzu yapın.
              </p>
              <Button href="/kayit-ol" class="bg-primary hover:bg-primary/90">Başvuru Yap</Button>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>

    <Footer />
  </div>
</Layout>
