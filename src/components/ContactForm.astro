---
import EnvelopeIcon from "heroicons/24/outline/envelope.svg"
import MapPinIcon from "heroicons/24/outline/map-pin.svg"
import PhoneIcon from "heroicons/24/outline/phone.svg"
import Button from "@/components/ui/Button.astro"
import Input from "@/components/ui/Input.astro"
import Textarea from "@/components/ui/Textarea.astro"
---

<section id="iletisim" class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold text-center mb-4 text-gray-900">İletişim</h2>
    <p class="text-center text-gray-600 mb-16 max-w-2xl mx-auto">
      Sorularınız ve kayıt işlemleri için bizimle iletişime geçin. Size en kısa sürede dönüş yapacağız.
    </p>

    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12">
        {/* Left: Contact Info */}
        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-8">İletişim Bilgileri</h3>

          <div class="space-y-6">
            {/* Email */}
            <div class="flex items-start gap-4">
              <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                <EnvelopeIcon class="h-5 w-5 text-primary" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">E-posta</h4>
                <a href="mailto:meclis@naal.org.tr" class="text-gray-600 hover:text-primary transition-colors">meclis@naal.org.tr</a>
              </div>
            </div>

            {/* Phone */}
            <div class="flex items-start gap-4">
              <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                <PhoneIcon class="h-5 w-5 text-primary" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Telefon</h4>
                <a href="tel:+902166317644" class="text-gray-600 hover:text-primary transition-colors">+90 (216) 631-7644</a>
              </div>
            </div>

            {/* Address */}
            <div class="flex items-start gap-4">
              <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                <MapPinIcon class="h-5 w-5 text-primary" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Adres</h4>
                <p class="text-gray-600">
                  Nevzat Ayaz Anadolu Lisesi<br />
                  İnkılap Mah. Yelkenciler Sok. No: 1<br />
                  Ümraniye, İstanbul, Türkiye
                </p>
              </div>
            </div>
          </div>
        </div>

        {/* Right: Contact Form */}
        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-8">Bize Yazın</h3>

          <div class="bg-white border-2 border-primary/20 rounded-lg p-8 shadow-sm">
            <form id="contact-form" class="space-y-5">
              {/* Web3Forms Access Key */}
              <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />

              {/* Name & Email Row */}
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="block text-sm font-medium text-gray-900 mb-2">
                    Ad Soyad
                  </label>
                  <Input id="name" name="name" type="text" required class="border-gray-300 focus:border-primary" />
                </div>

                <div>
                  <label for="email" class="block text-sm font-medium text-gray-900 mb-2">
                    E-posta
                  </label>
                  <Input id="email" name="email" type="email" required class="border-gray-300 focus:border-primary" />
                </div>
              </div>

              {/* Subject */}
              <div>
                <label for="subject" class="block text-sm font-medium text-gray-900 mb-2">
                  Konu
                </label>
                <Input id="subject" name="subject" type="text" required class="border-gray-300 focus:border-primary" />
              </div>

              {/* Message */}
              <div>
                <label for="message" class="block text-sm font-medium text-gray-900 mb-2">
                  Mesaj
                </label>
                <Textarea
                  id="message"
                  name="message"
                  required
                  rows={6}
                  class="border-gray-300 focus:border-primary resize-none"
                />
              </div>

              {/* Submit Button */}
              <Button
                type="submit"
                class="w-full bg-primary hover:bg-primary/90 text-white font-medium py-6 rounded-md"
              >
                Mesaj Gönder
              </Button>

              {/* Status Messages */}
              <p data-status="success" class="text-center text-green-600 font-medium" hidden>
                ✓ Mesajınız başarıyla gönderildi!
              </p>
              <p data-status="error" class="text-center text-red-600 font-medium" hidden>
                ✗ Bir hata oluştu. Lütfen tekrar deneyin.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form")!
  const submit = form.querySelector<HTMLButtonElement>('[type="submit"]')!
  const success = form.querySelector<HTMLElement>('[data-status="success"]')!
  const error = form.querySelector<HTMLElement>('[data-status="error"]')!

  form.addEventListener("submit", async (event) => {
    event.preventDefault()
    const idleLabel = submit.textContent
    submit.disabled = true
    submit.textContent = "Gönderiliyor..."
    success.hidden = true
    error.hidden = true

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: new FormData(form),
      })
      const data = await response.json()

      if (data.success) {
        success.hidden = false
        form.reset()
      } else {
        error.hidden = false
      }
    } catch {
      error.hidden = false
    } finally {
      submit.disabled = false
      submit.textContent = idleLabel
    }
  })
</script>
