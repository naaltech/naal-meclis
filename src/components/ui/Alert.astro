---
import type { HTMLAttributes } from "astro/types"
import { cn } from "@/lib/utils"

type Props = HTMLAttributes<"div">

const { class: className, ...props } = Astro.props
---

<div
  role="alert"
  class={cn(
    "bg-card text-card-foreground relative grid w-full grid-cols-[calc(var(--spacing)*4)_1fr] items-start gap-x-3 gap-y-0.5 rounded-lg border px-4 py-3 text-sm [&>svg]:size-4 [&>svg]:translate-y-0.5 [&>svg]:text-current",
    className,
  )}
  {...props}
>
  <slot />
</div>
